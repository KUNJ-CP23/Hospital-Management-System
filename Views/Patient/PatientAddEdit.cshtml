@* @model HMS.Models.PatientModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Patient Add/Edit</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .card-header {
            background-color: #25317d;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-actions a {
            margin-left: 8px;
        }

        .breadcrumb-container {
            text-align: right;
            margin-bottom: 10px;
        }

        .breadcrumb {
            background: transparent;
            padding: 0;
            margin: 0;
            font-size: 0.9rem;
        }

        .breadcrumb-item a {
            text-decoration: none;
            color: #25317d;
        }

        .breadcrumb-item.active {
            color: #6c757d;
            font-weight: 500;
        }

    </style>
</head>
<body>
    <div class="container mt-1">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <!-- Breadcrumb -->
                <div class="breadcrumb-container">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a asp-controller="Home" asp-action="Dashboard">Hospital Management</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a asp-controller="Patient" asp-action="PatientList">Patient</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">
                                @(Model.PatientID == 0 ? "Add" : "Edit")
                            </li>
                        </ol>
                    </nav>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header">
                        <h4 class="mb-0">
                            @(Model.PatientID == 0 ? "Patient Add" : "Patient Edit")
                        </h4>
                        <div class="header-actions">
                            <a asp-controller="Home" asp-action="Dashboard" class="btn btn-sm btn-outline-light">Dashboard</a>
                            <a asp-controller="Patient" asp-action="PatientList" class="btn btn-sm btn-outline-light">Back to List</a>
                        </div>
                    </div>
                    <div class="card-body">
                        <form asp-controller="Patient" asp-action="PatientAddEdit" method="post">
                            <input asp-for="PatientID" value="@Model.PatientID" hidden />

                            <div class="mb-3">
                                <label asp-for="Name" class="form-label">Name</label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
                                <input asp-for="DateOfBirth" class="form-control" type="date" />
                                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Gender</label>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Gender" value="Male" id="genderMale" />
                                    <label class="form-check-label" for="genderMale">Male</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Gender" value="Female" id="genderFemale" />
                                    <label class="form-check-label" for="genderFemale">Female</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Gender" value="Other" id="genderOther" />
                                    <label class="form-check-label" for="genderOther">Other</label>
                                </div>
                                <span asp-validation-for="Gender" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label">Email</label>
                                <input asp-for="Email" class="form-control" type="email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Phone" class="form-label">Phone</label>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Address" class="form-label">Address</label>
                                <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="City" class="form-label">City</label>
                                <input asp-for="City" class="form-control" />
                                <span asp-validation-for="City" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="State" class="form-label">State</label>
                                <input asp-for="State" class="form-control" />
                                <span asp-validation-for="State" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Is Active</label>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="IsActive" value="true" id="isActiveTrue" />
                                    <label class="form-check-label" for="isActiveTrue">Active</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="IsActive" value="false" id="isActiveFalse" />
                                    <label class="form-check-label" for="isActiveFalse">Inactive</label>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="UserID" class="form-label">User</label>
                                <select asp-for="UserID" class="form-select"
                                        asp-items="@(ViewBag.UserList != null ? new SelectList(ViewBag.UserList, "UserID", "UserName") : new List<SelectListItem>())">
                                    <option value=""> Select User </option>
                                </select>
                                <span asp-validation-for="UserID" class="text-danger"></span>
                            </div>

                            <div class="text-end">
                                <button type="submit" class="btn btn-outline-success">Save</button>
                                <a asp-controller="Patient" asp-action="PatientList" class="btn btn-secondary">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
} *@


@model HMS.Models.PatientModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Patient Add/Edit</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .card-header {
            background-color: #25317d;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-actions a {
            margin-left: 8px;
        }

        .breadcrumb-container {
            text-align: right;
            margin-bottom: 10px;
        }

        .breadcrumb {
            background: transparent;
            padding: 0;
            margin: 0;
            font-size: 0.9rem;
        }

        .breadcrumb-item a {
            text-decoration: none;
            color: #25317d;
        }

        .breadcrumb-item.active {
            color: #6c757d;
            font-weight: 500;
        }

    </style>
</head>
<body>
    <div class="container mt-1">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <!-- Breadcrumb -->
                <div class="breadcrumb-container">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a asp-controller="Home" asp-action="Dashboard">Hospital Management</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a asp-controller="Patient" asp-action="PatientList">Patient</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">
                                @(Model.PatientID == 0 ? "Add" : "Edit")
                            </li>
                        </ol>
                    </nav>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header">
                        <h4 class="mb-0">
                            @(Model.PatientID == 0 ? "Patient Add" : "Patient Edit")
                        </h4>
                        <div class="header-actions">
                            <a asp-controller="Home" asp-action="Dashboard" class="btn btn-sm btn-outline-light">Dashboard</a>
                            <a asp-controller="Patient" asp-action="PatientList" class="btn btn-sm btn-outline-light">Back to List</a>
                        </div>
                    </div>
                    <div class="card-body">
                        <form asp-controller="Patient" 
                              asp-action="PatientAddEdit" 
                              method="post" 
                              enctype="multipart/form-data">
                            <input asp-for="PatientID" value="@Model.PatientID" hidden />

                            <div class="mb-3">
                                <label asp-for="Name" class="form-label">Name</label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
                                <input asp-for="DateOfBirth" class="form-control" type="date"
                                       value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd"))" />
                                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Gender</label>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Gender" value="Male" id="genderMale" />
                                    <label class="form-check-label" for="genderMale">Male</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Gender" value="Female" id="genderFemale" />
                                    <label class="form-check-label" for="genderFemale">Female</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="Gender" value="Other" id="genderOther" />
                                    <label class="form-check-label" for="genderOther">Other</label>
                                </div>
                                <span asp-validation-for="Gender" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label">Email</label>
                                <input asp-for="Email" class="form-control" type="email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Phone" class="form-label">Phone</label>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Address" class="form-label">Address</label>
                                <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="City" class="form-label">City</label>
                                <input asp-for="City" class="form-control" />
                                <span asp-validation-for="City" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="State" class="form-label">State</label>
                                <input asp-for="State" class="form-control" />
                                <span asp-validation-for="State" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Is Active</label>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="IsActive" value="true" id="isActiveTrue" />
                                    <label class="form-check-label" for="isActiveTrue">Active</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="IsActive" value="false" id="isActiveFalse" />
                                    <label class="form-check-label" for="isActiveFalse">Inactive</label>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="UserID" class="form-label">User</label>
                                <select asp-for="UserID" class="form-select"
                                        asp-items="@(ViewBag.UserList != null ? new SelectList(ViewBag.UserList, "UserID", "UserName") : new List<SelectListItem>())">
                                    <option value=""> Select User </option>
                                </select>
                                <span asp-validation-for="UserID" class="text-danger"></span>
                            </div>

                            <!-- 📸 Image Upload -->
                            <div class="mb-3">
                                <label asp-for="PatientImage" class="form-label">Profile Image</label>
                                <input type="file" asp-for="PatientImage" class="form-control" accept="image/*" />

                                <!-- show preview if already uploaded -->
                                @if (!string.IsNullOrEmpty(Model.ImagePath))
                                {
                                    <div class="mt-2">
                                        <img src="~/uploads/patients/@Model.ImagePath"
                                             alt="Profile Image"
                                             style="width:120px;height:120px;object-fit:cover;border-radius:8px;border:1px solid #ddd;" />
                                    </div>
                                }
                            </div>

                            <div class="text-end">
                                <button type="submit" class="btn btn-outline-success">Save</button>
                                <a asp-controller="Patient" asp-action="PatientList" class="btn btn-secondary">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
}
