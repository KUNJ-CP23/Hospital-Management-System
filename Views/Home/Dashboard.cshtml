@* @model HMS.Models.DashboardModel
@{
    ViewBag.Title = "Dashboard";
}

<div class="container mt-5">
    <h2 class="mb-4 text-center">📊 Dashboard Overview</h2>

    <!-- Cards -->
    <div class="row g-4 mb-5">
