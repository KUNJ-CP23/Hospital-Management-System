@using System.Data;
@model System.Data.DataTable;
@using HMS.Helpers;

<style>
    body {
        font-family: 'Segoe UI', Arial, sans-serif;
        background: linear-gradient(to right, #f7f9fc, #eef1f6); /* soft gradient */
        color: #333;
    }

    /* Container centered */
    .main-container {
        max-width: 1100px;
        margin: 6px auto;
        padding: 0px 10px 0px 10px;
    }

    /* Header */
    .userlist-header {
        background: #ffffff;
        padding: 15px 25px;
        margin-bottom: 15px;
        border-radius: 12px;
        display: flex;
        justify-content: center;
        align-items: center;
        box-shadow: 0px 3px 10px rgba(0,0,0,0.08);
    }

    .userlist-title {
        font-weight: 600;
        color: #2a5d9f;
        margin: 0;
    }

    /* Buttons */
    .action-buttons {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-bottom: 20px;
    }

    .btn-custom {
        border-radius: 6px;
        font-size: 14px;
        padding: 6px 14px;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background-color: #2a5d9f;
        border: none;
    }

        .btn-primary:hover {
            background-color: #234b82;
        }

    .btn-secondary {
        background-color: #6c757d;
        border: none;
    }

        .btn-secondary:hover {
            background-color: #565e64;
        }

    .btn-success {
        background-color: #28a745;
        border: none;
    }

        .btn-success:hover {
            background-color: #1e7e34;
        }

    .btn-dan {
        color: #dc3545;
        border: 2px solid #dc3545;
        background-color: transparent;
        transition: all 0.3s ease;
    }

        .btn-dan:hover {
            background-color: #dc3545;
            color: #fff;
        }

    /* Edit button (blue outline by default, filled on hover) */
    .btn-war {
        color: dodgerblue;
        border: 2px solid dodgerblue;
        background-color: transparent;
        transition: all 0.3s ease;
    }

        .btn-war:hover {
            background-color: dodgerblue;
            color: #fff;
        }

    /* Search Row */
    .search-row {
        margin-bottom: 20px;
        background: #fff;
        padding: 12px;
        border-radius: 8px;
        box-shadow: 0px 2px 8px rgba(0,0,0,0.05);
    }

        .search-row input {
            border-radius: 6px;
        }

        .search-row button {
            border-radius: 6px;
            padding: 6px 16px;
        }

    /* Table */
    .table-container {
        background: #ffffff;
        padding: 15px;
        border-radius: 12px;
        box-shadow: 0px 3px 12px rgba(0,0,0,0.08);
    }

    .table thead {
        background-color: #2a5d9f;
        color: #fff;
    }

    .table-striped tbody tr:nth-child(odd) {
        background-color: #f8f9fb;
    }

    .table-striped tbody tr:nth-child(even) {
        background-color: #ffffff;
    }

    .table th, .table td {
        text-align: center;
        vertical-align: middle;
    }

    /* Alerts */
    .alert {
        margin: 10px auto;
        width: 90%;
        border-radius: 8px;
        box-shadow: 0px 2px 6px rgba(0,0,0,0.1);
    }
</style>


<div class="main-container">
    <!-- Header -->
    <div class="userlist-header">
        <h2 class="userlist-title">User List</h2>
    </div>

    <!-- Action Buttons -->
    <div class="action-buttons">
        <a href="@Url.Action("UserAddEdit", "User")" class="btn btn-primary btn-custom">
            <i class="bi bi-plus-circle"></i> Add User
        </a>
        <a href="@Url.Action("Dashboard", "Home")" class="btn btn-secondary btn-custom">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>
        <a class="btn btn-success btn-custom"
           asp-controller="ExportToExcel"
           asp-action="ExportToExcel"
           asp-route-sp="PR_User_SelectAll">
            <i class="bi bi-file-earmark-excel"></i> Export to Excel
        </a>
    </div>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div id="alertMessage" class="alert alert-success text-center fw-bold">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div id="alertMessage" class="alert alert-danger text-center fw-bold">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Search -->
    <form method="get" asp-action="UserList" class="search-row row g-2">
        <div class="col-md-3">
            <input type="text" name="UserName" class="form-control"
                   placeholder="User Name" value="@ViewBag.UserName" />
        </div>
        <div class="col-md-3">
            <input type="text" name="Email" class="form-control"
                   placeholder="Email" value="@ViewBag.Email" />
        </div>
        <div class="col-md-3">
            <input type="text" name="MobileNo" class="form-control"
                   placeholder="Mobile No" value="@ViewBag.MobileNo" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Search</button>
            <a href="@Url.Action("UserList")" class="btn btn-secondary">Clear</a>
        </div>
    </form>

    <!-- User Table -->
    <div class="table-container">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Sr. No.</th>
                        <th>UserName</th>
                        <th>Password</th>
                        <th>Email</th>
                        <th>MobileNo</th>
                        <th>IsActive</th>
                        <th>Edit/Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int srNo = 1;
                    }
                    @foreach (DataRow dr in Model.Rows)
                    {
                        var encryptedId = UrlEncryptor.Encrypt(dr["UserID"].ToString());
                        <tr>
                            <td>@srNo</td>
                            <td>@dr["UserName"]</td>
                            <td>@dr["Password"]</td>
                            <td>@dr["Email"]</td>
                            <td>@dr["MobileNo"]</td>
                            <td>@dr["IsActive"]</td>
                            <td>
                                <a href="@Url.Action("UserAddEdit", "User", new { UserID = encryptedId })"
                                   class="btn btn-war btn-sm"
                                   title="Edit User">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <button type="button"
                                        class="btn btn-dan btn-sm delete-user"
                                        data-id="@encryptedId"
                                        title="Delete User">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </td>
                        </tr>
                        srNo++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
