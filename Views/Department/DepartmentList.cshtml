@using System.Data;
@model System.Data.DataTable;
@using HMS.Helpers;

<style>
    body {
        font-family: 'Segoe UI', Arial, sans-serif;
        background: linear-gradient(to right, #f7f9fc, #eef1f6);
        color: #333;
    }

    .main-container {
        max-width: 1100px;
        margin: 6px auto;
        padding: 0px 10px 0px 10px;
    }

    .deptlist-header {
        background: #ffffff;
        padding: 15px 25px;
        margin-bottom: 15px;
        border-radius: 12px;
        display: flex;
        justify-content: center;
        align-items: center;
        box-shadow: 0px 3px 10px rgba(0,0,0,0.08);
    }

    .deptlist-title {
        font-weight: 600;
        color: #2a5d9f;
        margin: 0;
    }

    .action-buttons {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-bottom: 20px;
    }

    .btn-custom {
        border-radius: 6px;
        font-size: 14px;
        padding: 6px 14px;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background-color: #2a5d9f;
        border: none;
    }

        .btn-primary:hover {
            background-color: #234b82;
        }

    .btn-secondary {
        background-color: #6c757d;
        border: none;
    }

        .btn-secondary:hover {
            background-color: #565e64;
        }

    .btn-dan {
        color: #dc3545;
        border: 2px solid #dc3545;
        background-color: transparent;
        transition: all 0.3s ease;
    }

        .btn-dan:hover {
            background-color: #dc3545;
            color: #fff;
        }

    .btn-war {
        color: dodgerblue;
        border: 2px solid dodgerblue;
        background-color: transparent;
        transition: all 0.3s ease;
    }

        .btn-war:hover {
            background-color: dodgerblue;
            color: #fff;
        }

    .search-row {
        margin-bottom: 20px;
        background: #fff;
        padding: 12px;
        border-radius: 8px;
        box-shadow: 0px 2px 8px rgba(0,0,0,0.05);
    }

        .search-row input {
            border-radius: 6px;
        }

        .search-row button {
            border-radius: 6px;
            padding: 6px 16px;
        }

    .table-container {
        background: #ffffff;
        padding: 15px;
        border-radius: 12px;
        box-shadow: 0px 3px 12px rgba(0,0,0,0.08);
    }

    .table thead {
        background-color: #2a5d9f;
        color: #fff;
    }

    .table-striped tbody tr:nth-child(odd) {
        background-color: #f8f9fb;
    }

    .table-striped tbody tr:nth-child(even) {
        background-color: #ffffff;
    }

    .table th, .table td {
        text-align: center;
        vertical-align: middle;
    }

    .alert {
        margin: 10px auto;
        width: 90%;
        border-radius: 8px;
        box-shadow: 0px 2px 6px rgba(0,0,0,0.1);
    }
</style>

<div class="main-container">
    <!-- Header -->
    <div class="deptlist-header">
        <h2 class="deptlist-title">Department List</h2>
    </div>

    <!-- Search -->
    <form method="get" asp-action="DepartmentList" class="search-row row g-2 align-items-center">
        <!-- Search input -->
        <div class="col-md-3">
            <input type="text" name="DepartmentName" class="form-control"
                   placeholder="Department Name" value="@ViewBag.DepartmentName" />
        </div>

        <!-- Search & Clear buttons -->
        <div class="col-md-3 d-flex gap-2 justify-content-center">
            <button type="submit" class="btn btn-primary">Search</button>
            <a href="@Url.Action("DepartmentList")" class="btn btn-secondary">Clear</a>
        </div>

        <!-- Other Action buttons -->
        <div class="col-md-6 d-flex justify-content-end gap-2">
            <a href="@Url.Action("DepartmentAddEdit", "Department")" class="btn btn-primary btn-custom">
                <i class="bi bi-plus-circle"></i> Add Department
            </a>
            <a href="@Url.Action("Dashboard", "Home")" class="btn btn-secondary btn-custom">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <a class="btn btn-success btn-custom"
               asp-controller="ExportToExcel"
               asp-action="ExportToExcel"
               asp-route-sp="PR_Department_SelectAll">
                <i class="bi bi-file-earmark-excel"></i> Export to Excel
            </a>
        </div>
    </form>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success text-center fw-bold auto-hide">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger text-center fw-bold auto-hide">
            @TempData["ErrorMessage"]
        </div>
    }
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            setTimeout(function () {
                $(".auto-hide").slideUp(600);
            }, 3000);
        });
    </script>

    <!-- Department Table -->
    <div class="table-container">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Sr. No.</th>
                        <th>DeptName</th>
                        <th>Description</th>
                        @* <th>IsActive</th>
                        <th>UserId</th>
                        <th>UserName</th>*@
                        <th>Edit/Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int srNo = 1;
                    }
                    @foreach (DataRow dr in Model.Rows)
                    {
                        var encryptedId = UrlEncryptor.Encrypt(dr["DepartmentID"].ToString());
                        <tr>
                            <td>@srNo</td>
                            <td>@dr["DepartmentName"]</td>
                            <td>@dr["Description"]</td>
                            @* <td>@dr["IsActive"]</td>
                            <td>@dr["UserID"]</td>
                            <td>@dr["UserName"]</td> *@
                            <td>
                                <a href="@Url.Action("DepartmentAddEdit", "Department", new { DepartmentID = encryptedId })"
                                   class="btn btn-war btn-sm"
                                   title="Edit Department">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <button type="button"
                                        class="btn btn-dan btn-sm delete-department"
                                        data-id="@encryptedId"
                                        title="Delete Department">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </td>
                        </tr>
                        srNo++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".delete-department").forEach(button => {
            button.addEventListener("click", function () {
                const departmentId = this.getAttribute("data-id");
                Swal.fire({
                    title: "Are you sure?",
                    text: "You won't be able to revert this!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#3085d6",
                    cancelButtonColor: "#d33",
                    confirmButtonText: "Yes, delete it!"
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = `/Department/DepartmentDelete?DepartmentID=${departmentId}`;
                    }
                });
            });
        });
    });
</script>
