@model HMS.Models.DepartmentModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Department Add/Edit</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .card-header {
            background-color: #25317d;
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-actions a {
            margin-left: 8px;
        }
    </style>
</head>
<body>
    <div class="container mt-1">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h4 class="mb-0">
                            @(Model.DepartmentID == 0 ? "Department Add" : "Department Edit")
                        </h4>
                        <div class="header-actions">
                            <a asp-controller="Home" asp-action="Dashboard" class="btn btn-sm btn-outline-light">Dashboard</a>
                            <a asp-controller="Department" asp-action="DepartmentList" class="btn btn-sm btn-outline-light">Back to List</a>
                        </div>
                    </div>
                    <div class="card-body">
                        <form asp-controller="Department" asp-action="DepartmentAddEdit" method="post">
                            <input asp-for="DepartmentID" value="@Model.DepartmentID" hidden />

                            <div class="mb-3">
                                <label asp-for="DepartmentName" class="form-label">Department Name</label>
                                <input asp-for="DepartmentName" class="form-control" />
                                <span asp-validation-for="DepartmentName" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label">Description</label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Is Active</label>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="IsActive" value="true" id="isActiveTrue" />
                                    <label class="form-check-label" for="isActiveTrue">Active</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="IsActive" value="false" id="isActiveFalse" />
                                    <label class="form-check-label" for="isActiveFalse">Inactive</label>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="UserID" class="form-label">User</label>
                                <select asp-for="UserID" class="form-select" 
                                        asp-items="@(ViewBag.UserList != null ? new SelectList(ViewBag.UserList, "UserID", "UserName") : new List<SelectListItem>())">
                                    <option value=""> Select User </option>
                                </select>
                                <span asp-validation-for="UserID" class="text-danger"></span>
                            </div>

                            <div class="text-end">
                                <button type="submit" class="btn btn-outline-success">Save</button>
                                <a asp-controller="Department" asp-action="DepartmentList" class="btn btn-secondary">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
}
